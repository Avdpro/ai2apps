 NS_IMETHODIMP
+nsDOMWindowUtils::GetAi2AppsRenderingLeaseCount(int32_t* aResult) {
+  NS_ENSURE_ARG_POINTER(aResult);
+  *aResult = -1;
+  if (nsIWidget* widget = GetWidget()) {
+    if (nsIWidget* top = widget->GetTopLevelWidget()) {
+      *aResult = top->AI2AppsRenderingLeaseCount();
+    }
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsDOMWindowUtils::AdjustAI2AppsRenderingLease(int32_t aDelta, uint32_t* aResult) {
+  NS_ENSURE_ARG_POINTER(aResult);
+  if (aDelta != 1 && aDelta != -1) return NS_ERROR_INVALID_ARG;
+  if (nsIWidget* widget = GetWidget()) {
+    if (nsIWidget* top = widget->GetTopLevelWidget()) {
+      if (top->AdjustAI2AppsRenderingLease(aDelta)) {
+        *aResult = top->AI2AppsRenderingLeaseCount();
+        return NS_OK;
+      }
+    }
+  }
+  return NS_ERROR_NOT_AVAILABLE;
+}
