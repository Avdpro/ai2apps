+bool nsCocoaWindow::AdjustAI2AppsRenderingLease(int32_t aDelta) {
+  if (!mWindow || (aDelta != 1 && aDelta != -1) ||
+      mAI2AppsRenderingLeaseCount + aDelta < 0 ||
+      mAI2AppsRenderingLeaseCount + aDelta > 1024) {
+    return false;
+  }
+  mAI2AppsRenderingLeaseCount += aDelta;
+  // Recompute immediately on both edges, without ordering/focusing the window.
+  DispatchOcclusionEvent();
+  return true;
+}
