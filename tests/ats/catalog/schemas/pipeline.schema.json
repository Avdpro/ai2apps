{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "steps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "enabled": {"type": "boolean"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
          "type": {"enum": ["case", "action"]},
          "enabled": {"type": "boolean", "default": true},
          "caseId": {"type": "string"},
          "executionMode": {"enum": ["run", "skip", "manual"]},
          "expectedStatus": {"enum": ["passed", "failed", "blocked", "stop-when-failed", "stop-when-succeed"]},
          "action": {"enum": ["start-helper", "restart-app", "restart-local", "quit-all-relaunch", "reset-data", "human-test", "include-pipeline"]},
          "pipelineId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
          "humanInstructions": {"type": "string", "minLength": 1, "maxLength": 12000},
          "confirmTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
          "loginMode": {"enum": ["none", "auto", "selected"]},
          "accountEmail": {"type": "string", "pattern": "^test([1-9]|10)@ai2apps\\.com$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
