{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "steps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "enabled": {"type": "boolean"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
          "type": {"enum": ["case", "action"]},
          "caseId": {"type": "string"},
          "expectedStatus": {"enum": ["passed", "failed", "blocked", "stop-when-failed", "stop-when-succeed"]},
          "action": {"enum": ["restart-app", "restart-local", "quit-all-relaunch", "reset-data"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
