+const char* miss_resume_backend_version() { return "icb-gate-barrier-v2-mlx0320"; }
+
+void CommandEncoder::guarded_dispatch(MTL::Size grid, MTL::Size group, bool threads) {
+  std::string key=std::to_string(reinterpret_cast<uintptr_t>(current_pipeline_))+":"+
+    std::to_string(threads)+":"+std::to_string(grid.width)+":"+std::to_string(grid.height)+":"+
+    std::to_string(grid.depth)+":"+std::to_string(group.width)+":"+std::to_string(group.height)+":"+std::to_string(group.depth);
+  auto found=guarded_cache_.find(key);
+  if(found==guarded_cache_.end()) {
+    auto desc = NS::TransferPtr(MTL::IndirectCommandBufferDescriptor::alloc()->init());
+    desc->setCommandTypes(threads ? MTL::IndirectCommandTypeConcurrentDispatchThreads : MTL::IndirectCommandTypeConcurrentDispatch);
+    // Inherited pipeline state fails for dense GEMM on this tested device.
+    desc->setInheritPipelineState(false);
+    desc->setInheritBuffers(true);
+    auto icb = NS::TransferPtr(device_.mtl_device()->newIndirectCommandBuffer(desc.get(), 1, MTL::ResourceStorageModeShared));
+    if (!icb) throw std::runtime_error("miss-resume: ICB allocation failed");
+    auto cmd = icb->indirectComputeCommand(0);
+    cmd->setComputePipelineState(current_pipeline_);
+    if (threads) cmd->concurrentDispatchThreads(grid, group);
+    else cmd->concurrentDispatchThreadgroups(grid, group);
+    found=guarded_cache_.emplace(key,std::move(icb)).first;
+  }
+  auto enc = get_command_encoder();
+  enc->useResource(found->second.get(), MTL::ResourceUsageRead);
+  enc->useResource(miss_resume_range_, MTL::ResourceUsageRead | MTL::ResourceUsageWrite);
+  enc->executeCommandsInBuffer(found->second.get(), miss_resume_range_, 0);
+  // Cache entries are immutable and owned by the stream until synchronize/destruction.
 }

