+void CommandEncoder::capture_bytes(const void* data,size_t length,int idx) {
+  if(!capturing_){get_command_encoder()->setBytes(data,length,idx);return;}
+  constexpr size_t arena=4*1024*1024;
+  if(length>arena)throw std::runtime_error("capture constant too large");
+  if(capture_constant_used_+length>arena){capture_constant_index_++;capture_constant_used_=0;}
+  if(capture_constant_index_==capture_constants_.size())capture_constants_.push_back(NS::TransferPtr(device_.mtl_device()->newBuffer(arena,MTL::ResourceStorageModeShared)));
+  auto b=capture_constants_[capture_constant_index_].get();
+  memcpy(static_cast<char*>(b->contents())+capture_constant_used_,data,length);
+  capture_bindings_.at(idx)={b,capture_constant_used_};
+  capture_constant_used_+=(length+15)&~size_t(15);
+}
+void CommandEncoder::clear_capture() {
