+}
+void CommandEncoder::warm_capture(){
+  auto desc=NS::TransferPtr(MTL::IndirectCommandBufferDescriptor::alloc()->init());
+  desc->setCommandTypes(MTL::IndirectCommandTypeConcurrentDispatchThreads|MTL::IndirectCommandTypeConcurrentDispatch);
+  desc->setInheritBuffers(false);desc->setInheritPipelineState(false);desc->setMaxKernelBufferBindCount(31);
+  while(capture_pool_.size()<96){
+    auto icb=NS::TransferPtr(device_.mtl_device()->newIndirectCommandBuffer(desc.get(),capture_capacity_,MTL::ResourceStorageModeShared));
+    if(!icb)throw std::runtime_error("capture pool allocation");
+    icb->reset(NS::Range(0,capture_capacity_));capture_pool_.push_back(std::move(icb));
+  }
+  if(capture_constants_.empty())capture_constants_.push_back(NS::TransferPtr(device_.mtl_device()->newBuffer(4*1024*1024,MTL::ResourceStorageModeShared)));
+}
