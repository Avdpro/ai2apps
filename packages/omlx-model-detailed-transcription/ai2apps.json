{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-detailed-transcription-mlx",
    "type": "service",
    "version": "0.1.4",
    "displayName": "MLX WhisperX Detailed Transcription",
    "description": "Standalone subtitle and meeting transcription with Qwen3 ASR, forced alignment, VAD, and anonymous diarization. Not a Chat STT model."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": ["darwin"],
    "architectures": ["arm64"],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [
    {"name": "model-worker", "kind": "service", "path": "service.yaml"}
  ],
  "permissions": [
    {"capability": "model-weights.huggingface-cache.read", "reason": "Read only the four Host-selected pinned MLX checkpoints.", "required": true},
    {"capability": "accelerator.metal", "reason": "Run detailed transcription locally with MLX.", "required": true}
  ],
  "dependencies": [
    {"packageId": "ai2apps/runtime-omlx", "version": ">=1.6.0 <2.0.0", "optional": false}
  ],
  "files": [],
  "sbom": {"format": "spdx-json-2.3", "path": "META/sbom.spdx.json"},
  "discovery": {
    "kind": "model",
    "categories": ["speech"],
    "tasks": [
      "detailed-transcription",
      "speaker-diarization",
      "subtitle-generation"
    ]
  },
  "modelProfile": {
    "sizeBytes": 3832992557,
    "minimumMemoryBytes": 8589934592,
    "scores": {"speed": 3, "capability": 5},
    "benchmark": {
      "label": "Existing package estimate; not a new hardware benchmark",
      "device": "Apple Silicon reference hardware"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.detailed-transcription-mlx",
    "models": [
      {
        "id": "ai2apps.model.detailed-transcription-mlx/quality",
        "label": "Detailed Transcription Quality",
        "recommended": true
      },
      {
        "id": "ai2apps.model.detailed-transcription-mlx/compact",
        "label": "Detailed Transcription Compact",
        "recommended": false
      }
    ]
  }
}
