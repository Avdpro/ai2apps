{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-sensevoice-small-cuda",
    "type": "service",
    "version": "0.1.0",
    "displayName": "SenseVoice Small CUDA",
    "description": "Official FunASR SenseVoice Small CUDA transcription with a pinned CPU FSMN VAD helper for long audio."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "linux"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read the pinned SenseVoice checkpoint.",
      "required": true
    },
    {
      "capability": "accelerator.cuda",
      "reason": "Run SenseVoice transcription on CUDA.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-cuda-torch",
      "version": ">=0.6.0 <1.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "speech"
    ],
    "tasks": [
      "speech-recognition"
    ]
  },
  "modelProfile": {
    "sizeBytes": 938413143,
    "minimumMemoryBytes": 4294967296,
    "scores": {
      "speed": 4,
      "capability": 4
    },
    "benchmark": {
      "label": "Estimated memory; basic CUDA inference verified, signed installation pending",
      "device": "NVIDIA DGX Spark GB10"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.sensevoice-small-cuda",
    "models": [
      {
        "id": "ai2apps.model.sensevoice-small-cuda/default",
        "label": "SenseVoice Small CUDA",
        "recommended": true
      }
    ]
  }
}
