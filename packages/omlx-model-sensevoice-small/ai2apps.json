{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-sensevoice-small",
    "type": "service",
    "version": "0.2.2",
    "displayName": "SenseVoice Small",
    "description": "SenseVoiceSmall multilingual speech recognition by FunAudioLLM / FunASR for AI2Apps Chat. FunASR Model License 1.1; license and attribution included."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": ["darwin"],
    "architectures": ["arm64"],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [{"name": "model-worker", "kind": "service", "path": "service.yaml"}],
  "permissions": [
    {"capability": "model-weights.huggingface-cache.read", "reason": "Read the pinned SenseVoice checkpoint.", "required": true},
    {"capability": "accelerator.metal", "reason": "Run local speech recognition.", "required": true}
  ],
  "dependencies": [
    {"packageId": "ai2apps/runtime-omlx", "version": ">=1.3.1 <2.0.0", "optional": false},
    {"packageId": "ai2apps/punctuation-restorer", "version": ">=0.1.0 <1.0.0", "optional": false}
  ],
  "files": [],
  "sbom": {"format": "spdx-json-2.3", "path": "META/sbom.spdx.json"}
}
