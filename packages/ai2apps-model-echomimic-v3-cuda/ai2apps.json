{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-echomimic-v3-cuda",
    "type": "service",
    "version": "0.1.0",
    "displayName": "EchoMimic V3 CUDA",
    "description": "Reference-image and driving-audio avatar video with the pinned official CUDA pipeline."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "linux"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read only the Host-selected immutable EchoMimic weights.",
      "required": true
    },
    {
      "capability": "accelerator.cuda",
      "reason": "Run pinned Torch avatar inference.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-cuda-torch",
      "version": ">=0.6.0 <1.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "video"
    ],
    "tasks": [
      "video-generation",
      "avatar-animation"
    ]
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.echomimic-v3-cuda",
    "models": [
      {
        "id": "ai2apps.model.echomimic-v3-cuda/default",
        "label": "EchoMimic V3 CUDA",
        "recommended": true
      }
    ]
  },
  "modelProfile": {
    "sizeBytes": 20766374281,
    "minimumMemoryBytes": 34359738368,
    "scores": {
      "speed": 2,
      "capability": 4
    },
    "benchmark": {
      "label": "Estimated memory; CUDA development inference verified, signed installation pending",
      "device": "NVIDIA DGX Spark GB10"
    }
  }
}
