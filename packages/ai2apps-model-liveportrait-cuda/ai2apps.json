{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-liveportrait-cuda",
    "type": "service",
    "version": "0.1.0",
    "displayName": "LivePortrait CUDA",
    "description": "Official LivePortrait Torch animation with YuNet and 203-point landmarks on NVIDIA CUDA."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "linux"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read only the Host-selected pinned CUDA LivePortrait checkpoint.",
      "required": true
    },
    {
      "capability": "accelerator.cuda",
      "reason": "Run official Torch portrait animation on CUDA.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-cuda-torch",
      "version": ">=0.6.0 <1.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "video"
    ],
    "tasks": [
      "video-generation",
      "portrait-animation"
    ]
  },
  "modelProfile": {
    "sizeBytes": 635609433,
    "minimumMemoryBytes": 17179869184,
    "scores": {
      "speed": 2,
      "capability": 4
    },
    "benchmark": {
      "label": "Estimated memory; CUDA development inference verified, shared Runtime signed installation pending",
      "device": "NVIDIA DGX Spark GB10"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.liveportrait-cuda",
    "models": [
      {
        "id": "ai2apps.model.liveportrait-cuda/liveportrait",
        "label": "LivePortrait CUDA",
        "recommended": true
      }
    ]
  }
}
