{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-qwen38-flash-next-cuda",
    "type": "service",
    "version": "0.1.0",
    "displayName": "Qwen3.8 Flash Next CUDA (experimental)",
    "description": "Experimental affine Q4 disk-expert CUDA correctness baseline; parity and performance gates remain open."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "linux"
    ],
    "architectures": [
      "arm64"
    ],
    "minimumOsVersion": "24.4"
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read only the Host-selected pinned Qwen3.8 repository cache.",
      "required": true
    },
    {
      "capability": "accelerator.cuda",
      "reason": "Run isolated inference on NVIDIA GB10.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-cuda-torch",
      "version": ">=0.2.0 <1.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "multimodal"
    ],
    "tasks": [
      "multimodal-conversation",
      "image-understanding"
    ]
  },
  "modelProfile": {
    "sizeBytes": 111602375389,
    "minimumMemoryBytes": 85899345920,
    "scores": {
      "speed": 1,
      "capability": 5
    },
    "benchmark": {
      "label": "Experimental disk baseline; parity/performance acceptance pending",
      "device": "DGX Spark GB10"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.qwen38-flash-next-4bit",
    "models": [
      {
        "id": "ai2apps.model.qwen38-flash-next-4bit/qwen3.8-flash-next-mlx-4bit",
        "label": "Qwen3.8 Flash Next CUDA (experimental)",
        "recommended": true
      }
    ]
  }
}
