{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {"id": "ai2apps/model-flux2-klein-mlx", "type": "service", "version": "0.1.3", "displayName": "FLUX.2 Klein MLX", "description": "Optimized FLUX.2 Klein 4B generation and editing."},
