  ],
  "dependencies": [{"packageId": "ai2apps/runtime-omlx", "version": ">=1.5.0 <2.0.0", "optional": false}],
  "files": [],
  "sbom": {"format": "spdx-json-2.3", "path": "META/sbom.spdx.json"}
}
