{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-flux2-klein-cuda",
    "type": "service",
    "version": "0.1.0",
    "displayName": "FLUX.2 Klein 4B CUDA",
    "description": "BF16 CUDA image generation and editing with 1\u20134 reference images. Signed Package installation pending."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "linux"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read a pinned FLUX.2 checkpoint.",
      "required": true
    },
    {
      "capability": "accelerator.cuda",
      "reason": "Run BF16 CUDA image inference.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-cuda-torch",
      "version": ">=0.6.0 <1.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "image"
    ],
    "tasks": [
      "image-generation",
      "image-edit"
    ]
  },
  "modelProfile": {
    "sizeBytes": 15980131745,
    "minimumMemoryBytes": 34359738368,
    "scores": {
      "speed": 2,
      "capability": 4
    },
    "benchmark": {
      "label": "Estimated BF16 memory; basic isolated Worker verified, signed Package installation pending",
      "device": "NVIDIA DGX Spark GB10"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.flux2-klein-cuda",
    "models": [
      {
        "id": "ai2apps.model.flux2-klein-cuda/4b",
        "label": "FLUX.2 Klein 4B CUDA",
        "recommended": true
      }
    ]
  }
}
