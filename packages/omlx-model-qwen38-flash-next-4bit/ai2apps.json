  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read only the Host-selected pinned Qwen3.8 Flash Next checkpoint.",
      "required": true
    },
    {
      "capability": "accelerator.metal",
      "reason": "Run the isolated oMLX multimodal engine on Apple GPU.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-omlx",
      "version": ">=1.7.5 <2.0.0",
      "optional": false
    }
