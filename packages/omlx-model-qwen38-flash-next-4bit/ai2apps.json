  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "multimodal"
    ],
    "tasks": [
      "multimodal-conversation",
      "image-understanding"
    ]
  },
  "modelProfile": {
    "sizeBytes": 111602367013,
    "minimumMemoryBytes": 68719476736,
    "scores": {
      "speed": 3,
      "capability": 5
    },
    "benchmark": {
      "label": "SSD-ready Cached-MoE Lean Top128/Hot10; runtime estimate",
      "device": "AI2Apps runtime tier / reference-host measurement"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.qwen38-flash-next-4bit",
    "models": [
      {
        "id": "ai2apps.model.qwen38-flash-next-4bit/qwen3.8-flash-next-mlx-4bit",
