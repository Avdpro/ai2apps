{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-qwen38-flash-next-4bit",
    "type": "service",
    "version": "0.1.0",
    "displayName": "Qwen3.8 Flash Next 4-bit",
    "description": "Multimodal Qwen4-Exp Worker with full and Cached-MoE execution."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": ["darwin"],
    "architectures": ["arm64"],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [
    {"name": "model-worker", "kind": "service", "path": "service.yaml"}
  ],
  "permissions": [
    {"capability": "model-weights.huggingface-cache.read", "reason": "Read only the Host-selected pinned Qwen3.8 Flash Next checkpoint.", "required": true},
    {"capability": "accelerator.metal", "reason": "Run the isolated oMLX multimodal engine on Apple GPU.", "required": true}
  ],
  "dependencies": [
    {"packageId": "ai2apps/runtime-omlx", "version": ">=1.5.5 <2.0.0", "optional": false}
  ],
  "files": [],
  "sbom": {"format": "spdx-json-2.3", "path": "META/sbom.spdx.json"}
}
