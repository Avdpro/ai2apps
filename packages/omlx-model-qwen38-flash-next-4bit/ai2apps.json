{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-qwen38-flash-next-4bit",
    "type": "service",
    "version": "0.1.4",
    "displayName": "Qwen3.8 Flash Next 4-bit",
    "description": "Multimodal Qwen4-Exp Worker with full and Cached-MoE execution."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "darwin"
    ],
    "architectures": [
      "arm64"
    ],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
