{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/punctuation-restorer",
    "type": "service",
    "version": "0.1.1",
    "displayName": "CT-Transformer Punctuation Restorer",
    "description": "Required local Chinese/English punctuation restoration dependency for ASR Packages."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": ["darwin"],
    "architectures": ["arm64"],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [{"name": "model-worker", "kind": "service", "path": "service.yaml"}],
  "permissions": [
    {"capability": "model-weights.huggingface-cache.read", "reason": "Read the pinned CT-Transformer ONNX checkpoint.", "required": true}
  ],
  "dependencies": [{"packageId": "ai2apps/runtime-omlx", "version": ">=1.2.0 <2.0.0", "optional": false}],
  "files": [],
  "sbom": {"format": "spdx-json-2.3", "path": "META/sbom.spdx.json"}
}
