{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-sol-refiner-mlx",
    "type": "service",
    "version": "0.1.3",
    "displayName": "SoL-Refiner Image & Video Upscaler MLX",
    "description": "2x image and video upscaling. Images return PNG with preserved alpha; videos preserve audio. Standard: 28.71 GB. Optional Custom Prompts: 57.04 GB total with shared weights."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "darwin"
    ],
    "architectures": [
      "arm64"
    ],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Run the dedicated SoL-Refiner video upscaler using the pinned checkpoint and Metal.",
      "required": true
    },
    {
      "capability": "accelerator.metal",
      "reason": "Run the dedicated SoL-Refiner video upscaler using the pinned checkpoint and Metal.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-omlx",
      "version": ">=1.8.8 <2.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "image",
      "video"
    ],
    "tasks": [
      "image-upscaling",
      "video-upscaling"
    ]
  },
  "modelProfile": {
    "sizeBytes": 28705240872,
    "minimumMemoryBytes": 25769803776,
    "scores": {
      "speed": 2,
      "capability": 3
    },
    "benchmark": {
      "label": "33/65/129-frame 1024-square prototype, 2026-10-01",
      "device": "Apple M5 Max 128 GiB"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.sol-refiner-mlx",
    "models": [
      {
        "id": "ai2apps.model.sol-refiner-mlx/ltx23-one-step",
        "label": "Standard Upscaling / \u6807\u51c6\u653e\u5927 - 28.71 GB",
        "recommended": true
      },
      {
        "id": "ai2apps.model.sol-refiner-mlx/ltx23-custom-prompt",
        "label": "Custom Prompts / \u81ea\u5b9a\u4e49\u63d0\u793a\u8bcd - 57.04 GB; +28.33 GB after Standard",
        "recommended": false
      }
    ]
  }
}
