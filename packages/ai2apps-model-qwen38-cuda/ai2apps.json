{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-qwen38-cuda",
    "type": "service",
    "version": "0.2.0",
    "displayName": "Qwen3.8 27B CUDA",
    "description": "Qwen3.8 text, image, reasoning and tool Worker; native NVFP4 MLP on GB10, remaining FP8 layers dequantized to BF16."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "linux"
    ],
    "architectures": [
      "arm64"
    ],
    "minimumOsVersion": "24.4"
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read only the Host-selected pinned Qwen3.8 repository cache.",
      "required": true
    },
    {
      "capability": "accelerator.cuda",
      "reason": "Run isolated inference on NVIDIA GB10.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-cuda-torch",
      "version": ">=0.3.0 <1.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "multimodal"
    ],
    "tasks": [
      "multimodal-conversation",
      "image-understanding"
    ]
  },
  "modelProfile": {
    "sizeBytes": 23444503536,
    "minimumMemoryBytes": 85899345920,
    "scores": {
      "speed": 1,
      "capability": 5
    },
    "benchmark": {
      "label": "64 fixed tokens: 6.29 t/s median; 30.91 GiB resident, 35.34 GiB load peak. Short context only.",
      "device": "DGX Spark GB10"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.qwen38",
    "models": [
      {
        "id": "ai2apps.model.qwen38/qwen3.8-27b-nvfp4",
        "label": "Qwen3.8 27B CUDA (native NVFP4 MLP)",
        "recommended": true
      }
    ]
  }
}
