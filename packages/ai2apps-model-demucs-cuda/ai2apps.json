{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-demucs-cuda",
    "type": "service",
    "version": "0.1.0",
    "displayName": "Demucs CUDA",
    "description": "HTDemucs CUDA separation using fixed safe weights and the shared media pipeline."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "linux"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read the fixed safe HTDemucs checkpoint.",
      "required": true
    },
    {
      "capability": "accelerator.cuda",
      "reason": "Run fixed HTDemucs FP32 separation.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-cuda-torch",
      "version": ">=0.6.0 <1.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "speech"
    ],
    "tasks": [
      "source-separation"
    ]
  },
  "modelProfile": {
    "sizeBytes": 168007757,
    "minimumMemoryBytes": 8589934592,
    "scores": {
      "speed": 2,
      "capability": 4
    },
    "benchmark": {
      "label": "Estimated memory; three separation profiles verified in development, signed installation pending",
      "device": "NVIDIA DGX Spark GB10"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.demucs-cuda",
    "models": [
      {
        "id": "ai2apps.model.demucs-cuda/default",
        "label": "Demucs HTDemucs CUDA FP32",
        "recommended": true
      }
    ]
  }
}
