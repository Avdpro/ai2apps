{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/punctuation-restorer-cuda",
    "type": "service",
    "version": "0.1.0",
    "displayName": "CT-Transformer Punctuation Restorer",
    "description": "Chinese/English CT-Transformer punctuation restoration on CPU in the isolated Linux CUDA Runtime. No conversational model."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "linux"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read the pinned CT-Transformer ONNX checkpoint.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-cuda-torch",
      "version": ">=0.6.0 <1.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  }
}
