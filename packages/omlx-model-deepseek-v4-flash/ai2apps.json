{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-deepseek-v4-flash",
    "type": "service",
    "version": "0.3.4",
    "displayName": "DeepSeek V4 Flash",
    "description": "Isolated full and Cached-MoE Worker for DeepSeek V4 Flash."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "darwin"
    ],
    "architectures": [
      "arm64"
    ],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read only the Host-selected pinned DeepSeek repository cache.",
      "required": true
    },
    {
      "capability": "accelerator.metal",
      "reason": "Run the isolated oMLX engine on Apple GPU.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-omlx",
      "version": ">=1.7.5 <2.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "text"
    ],
    "tasks": [
      "text-generation"
    ]
  },
  "modelProfile": {
    "sizeBytes": 159635168163,
    "minimumMemoryBytes": 51539607552,
    "scores": {
      "speed": 2,
      "capability": 5
    },
    "benchmark": {
      "label": "SSD-ready Cached-MoE Lean Top20; runtime estimate",
      "device": "AI2Apps runtime tier / reference-host measurement"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.deepseek-v4-flash",
    "models": [
      {
        "id": "ai2apps.model.deepseek-v4-flash/deepseek-v4-flash",
        "label": "DeepSeek V4 Flash",
        "recommended": true
      }
    ]
  }
}
