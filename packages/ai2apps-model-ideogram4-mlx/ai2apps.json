{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-ideogram4-mlx",
    "type": "service",
    "version": "0.1.2",
    "displayName": "Ideogram 4 MLX",
    "description": "Ideogram 4 text-to-image generation only; Remix editing is disabled pending acceptance."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "darwin"
    ],
    "architectures": [
      "arm64"
    ],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read the pinned Ideogram 4 FP8 checkpoint selected by the Host.",
      "required": true
    },
    {
      "capability": "accelerator.metal",
      "reason": "Run the optimized native MLX image pipeline.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-omlx",
      "version": ">=1.5.2 <2.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "image"
    ],
    "tasks": [
      "image-generation"
    ]
  },
  "modelProfile": {
    "sizeBytes": 30064771072,
    "minimumMemoryBytes": 25769803776,
    "scores": {
      "speed": 2,
      "capability": 5
    },
    "benchmark": {
      "label": "Existing package estimates; not a new hardware benchmark",
      "device": "Apple Silicon reference hardware"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.ideogram4-mlx",
    "models": [
      {
        "id": "ai2apps.model.ideogram4-mlx/fp8-q4",
        "label": "Ideogram 4 MLX",
        "recommended": true
      }
    ]
  }
}
