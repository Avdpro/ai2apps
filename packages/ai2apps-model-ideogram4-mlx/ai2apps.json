{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-ideogram4-mlx",
    "type": "service",
    "version": "0.1.1",
    "displayName": "Ideogram 4 MLX",
    "description": "Optimized native MLX Ideogram 4 generation and single-image Remix editing."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": ["darwin"],
    "architectures": ["arm64"],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [{"name": "model-worker", "kind": "service", "path": "service.yaml"}],
  "permissions": [
    {"capability": "model-weights.huggingface-cache.read", "reason": "Read the pinned Ideogram 4 FP8 checkpoint selected by the Host.", "required": true},
    {"capability": "accelerator.metal", "reason": "Run the optimized native MLX image pipeline.", "required": true}
  ],
  "dependencies": [{"packageId": "ai2apps/runtime-omlx", "version": ">=1.5.2 <2.0.0", "optional": false}],
  "files": [],
  "sbom": {"format": "spdx-json-2.3", "path": "META/sbom.spdx.json"}
}
