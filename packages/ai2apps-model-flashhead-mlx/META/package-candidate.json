{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-flashhead-mlx",
    "type": "service",
    "version": "0.1.0",
    "displayName": "FlashHead Lite / Pro MLX",
    "description": "Native MLX image and audio driven avatar video generation; Lite recommended."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "darwin"
    ],
    "architectures": [
      "arm64"
    ],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read Host-selected immutable FlashHead weights.",
      "required": true
    },
    {
      "capability": "accelerator.metal",
      "reason": "Run native MLX avatar inference.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-omlx",
      "version": ">=1.8.5 <2.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "video"
    ],
    "tasks": [
      "video-generation",
      "avatar-animation"
    ]
  },
  "modelProfile": {
    "sizeBytes": 8161965386,
    "minimumMemoryBytes": 34359738368,
    "scores": {
      "speed": 4,
      "capability": 3
    },
    "benchmark": {
      "label": "Lite 512x512, 4 steps, 60-second video in 99.71 seconds including load and validation; publisher rating",
      "device": "Apple M5 Max 128 GiB"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.flashhead-mlx",
    "models": [
      {
        "id": "ai2apps.model.flashhead-mlx/lite",
        "label": "FlashHead Lite MLX",
        "recommended": true
      },
      {
        "id": "ai2apps.model.flashhead-mlx/pro",
        "label": "FlashHead Pro MLX",
        "recommended": false
      }
    ]
  }
}
