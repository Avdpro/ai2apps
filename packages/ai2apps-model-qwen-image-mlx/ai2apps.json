{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-qwen-image-mlx",
    "type": "service",
    "version": "0.1.3",
    "displayName": "Qwen Image MLX",
    "description": "Unified Qwen Image 2.1 text-to-image and instruction-based editing with RGBA PNG and WebP output."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "darwin"
    ],
    "architectures": [
      "arm64"
    ],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read pinned Qwen Image checkpoints resolved by the Host.",
      "required": true
    },
    {
      "capability": "accelerator.metal",
      "reason": "Run native MLX image generation and editing.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-omlx",
      "version": ">=1.8.17 <2.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "image"
    ],
    "tasks": [
      "image-generation",
      "image-edit"
    ]
  },
  "modelProfile": {
    "sizeBytes": 33131601593,
    "minimumMemoryBytes": 34359738368,
    "scores": {
      "speed": 2,
      "capability": 5
    },
    "benchmark": {
      "label": "M5 Max smoke tested at 512×512 Q8; memory floor estimated",
      "device": "Apple M5 Max"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.qwen-image-mlx",
    "models": [
      {
        "id": "ai2apps.model.qwen-image-mlx/2.1",
        "label": "Qwen Image 2.1 MLX",
        "recommended": true
      }
    ]
  }
}
