{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-cosyvoice3-cuda",
    "type": "service",
    "version": "0.1.0",
    "displayName": "CosyVoice 3 CUDA",
    "description": "Official FP32 CosyVoice 3 CUDA speech synthesis with cloning, instructions and native speed control."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "linux"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read Host-selected fixed official CosyVoice checkpoint.",
      "required": true
    },
    {
      "capability": "accelerator.cuda",
      "reason": "Run CosyVoice on CUDA.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-cuda-torch",
      "version": ">=0.6.0 <1.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "speech"
    ],
    "tasks": [
      "text-to-speech",
      "voice-cloning"
    ]
  },
  "modelProfile": {
    "sizeBytes": 5427029150,
    "minimumMemoryBytes": 17179869184,
    "scores": {
      "speed": 3,
      "capability": 3
    },
    "benchmark": {
      "label": "Estimated memory; official CUDA evidence retained, install pending",
      "device": "NVIDIA DGX Spark GB10"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.cosyvoice3-cuda",
    "models": [
      {
        "id": "ai2apps.model.cosyvoice3-cuda/original-fp32",
        "label": "CosyVoice 3 Official FP32",
        "recommended": true
      }
    ]
  }
}
