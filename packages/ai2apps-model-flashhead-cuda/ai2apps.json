{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-flashhead-cuda",
    "type": "service",
    "version": "0.1.0",
    "displayName": "FlashHead Lite / Pro CUDA",
    "description": "Official single-GPU FlashHead Lite and Pro audio-driven avatar video on CUDA."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": [
      "linux"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "entrypoints": [
    {
      "name": "model-worker",
      "kind": "service",
      "path": "service.yaml"
    }
  ],
  "permissions": [
    {
      "capability": "model-weights.huggingface-cache.read",
      "reason": "Read Host-selected immutable FlashHead weights.",
      "required": true
    },
    {
      "capability": "accelerator.cuda",
      "reason": "Run official FlashHead Torch inference.",
      "required": true
    }
  ],
  "dependencies": [
    {
      "packageId": "ai2apps/runtime-cuda-torch",
      "version": ">=0.6.0 <1.0.0",
      "optional": false
    }
  ],
  "files": [],
  "sbom": {
    "format": "spdx-json-2.3",
    "path": "META/sbom.spdx.json"
  },
  "discovery": {
    "kind": "model",
    "categories": [
      "video"
    ],
    "tasks": [
      "video-generation",
      "avatar-animation"
    ]
  },
  "modelProfile": {
    "sizeBytes": 8161965386,
    "minimumMemoryBytes": 34359738368,
    "scores": {
      "speed": 2,
      "capability": 3
    },
    "benchmark": {
      "label": "Estimated memory; Lite 60s and Pro 10s development inference verified; shared Runtime signed installation pending",
      "device": "NVIDIA DGX Spark GB10"
    }
  },
  "modelInstall": {
    "serviceKey": "ai2apps.model.flashhead-cuda",
    "models": [
      {
        "id": "ai2apps.model.flashhead-cuda/lite",
        "label": "FlashHead Lite CUDA",
        "recommended": true
      },
      {
        "id": "ai2apps.model.flashhead-cuda/pro",
        "label": "FlashHead Pro CUDA",
        "recommended": false
      }
    ]
  }
}
