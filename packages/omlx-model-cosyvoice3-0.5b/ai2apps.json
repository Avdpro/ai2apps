{
  "schemaVersion": "ai2apps.package-manifest.v1",
  "package": {
    "id": "ai2apps/model-cosyvoice3-05b",
    "type": "service",
    "version": "0.1.1",
    "displayName": "CosyVoice 3 0.5B",
    "description": "Local MLX CosyVoice 3 synthesis with zero-shot voice cloning and instruction control."
  },
  "compatibility": {
    "ai2apps": ">=0.1.0 <2.0.0",
    "platforms": ["darwin"],
    "architectures": ["arm64"],
    "minimumOsVersion": "26.2"
  },
  "entrypoints": [{"name": "model-worker", "kind": "service", "path": "service.yaml"}],
  "permissions": [
    {"capability": "model-weights.huggingface-cache.read", "reason": "Read pinned CosyVoice 3 MLX checkpoints selected by the Host.", "required": true},
    {"capability": "accelerator.metal", "reason": "Run local CosyVoice synthesis with MLX.", "required": true}
  ],
  "dependencies": [{"packageId": "ai2apps/runtime-omlx", "version": ">=1.3.9 <2.0.0", "optional": false}],
  "files": [],
  "sbom": {"format": "spdx-json-2.3", "path": "META/sbom.spdx.json"}
}
